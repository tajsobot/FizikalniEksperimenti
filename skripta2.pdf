ujejo uporabo senzorjev za raÄunalniÅ¡ko zajemanje podatkov, kot s kvalitativnega vidika, saj eksperimenti zahtevajo opis opaÅ¾anj. Nadgradi se tudi analiza rezultatov in primerjava pridobljenih kvantitativnih rezultatov s kvalitativnimi opaÅ¾anji. "/> <rdf:li photoshop:LayerName="II." photoshop:LayerText="II."/> </rdf:Bag> </photoshop:TextLayers> <photoshop:DocumentAncestors> <rdf:Bag> <rdf:li>373EAD46BC1D47CF15420B2A3C0A3DBA</rdf:li> <rdf:li>4446DC70B943C05DAFAE9A64205B023B</rdf:li> <rdf:li>4D8AFA31F16ADB68B16404657BB48830</rdf:li> <rdf:li>6DB50DA6513890407D117AEAB03C16ED</rdf:li> <rdf:li>7696F3C3C7B0F6A0A3A217348B946A22</rdf:li> <rdf:li>7F2E2B99CC0FAA78CAA9A43F0A396276</rdf:li> <rdf:li>9957953437EC2B3B1024AAAEB495FC62</rdf:li> <rdf:li>CEE0C2A0F98F824D1EDC5B97170EA83B</rdf:li> </rdf:Bag> </photoshop:DocumentAncestors> <xmpMM:History> <rdf:Seq> <rdf:li stEvt:action="created" stEvt:instanceID="xmp.iid:3cd74e0a-c4c4-4041-894e-3f49486bf5c6" stEvt:when="2022-06-30T13:07:36+02:00" stEvt:softwareAgent="Adobe Photoshop 21.2 (Windows)"/> <rdf:li stEvt:action="saved" stEvt:instanceID="xmp.iid:296e824b-f165-244b-88d1-c2229bc98306" stEvt:when="2022-06-30T13:16:28+02:00" stEvt:softwareAgent="Adobe Photoshop 21.2 (Windows)" stEvt:changed="/"/> <rdf:li stEvt:action="saved" stEvt:instanceID="xmp.iid:253e3fb5-40aa-7b42-964b-68283a22b417" stEvt:when="2022-07-07T06:58:26+02:00" stEvt:softwareAgent="Adobe Photoshop 21.2 (Windows)" stEvt:changed="/"/> <rdf:li stEvt:action="converted" stEvt:parameters="from application/vnd.adobe.photoshop to image/jpeg"/> <rdf:li stEvt:action="derived" stEvt:parameters="converted from application/vnd.adobe.photoshop to image/jpeg"/> <rdf:li stEvt:action="saved" stEvt:instanceID="xmp.iid:ab859a02-c39f-6e4d-8e34-32c04ff64016" stEvt:when="2022-07-07T06:58:26+02:00" stEvt:softwareAgent="Adobe Photoshop 21.2 (Windows)" stEvt:changed="/"/> </rdf:Seq> </xmpMM:History> <xmpMM:DerivedFrom stRef:instanceID="xmp.iid:253e3fb5-40aa-7b42-964b-68283a22b417" stRef:do